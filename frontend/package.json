{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "_comment": "vercel runs from the repo root because the project's Root Directory is \"frontend\"; --cwd .. lets you stay in frontend/",
