# Origin of the backend API. No trailing slash.
#
# Leave unset for local development: src/api/config.ts falls back to
# http://127.0.0.1:8000, which matches `python3 -m uvicorn main:app --reload`
# run from the app/ directory.
#
# Vite inlines this at build time, so it ends up in the published bundle --
# it is configuration, not a secret.
VITE_API_BASE_URL=https://your-service.up.railway.app
