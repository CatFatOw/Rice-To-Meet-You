# Copy this file to .env and replace every placeholder locally.
# .env is gitignored; do not commit credentials.

# Used by app/database.py and every FastAPI route through get_db.
DATABASE_URL=postgresql://<db_user>:<db_password>@<neon_host>/<database>?sslmode=require

# Used only by the scheduled Neon usage/cost collector.
NEON_API_KEY=<your_neon_account_api_key>
NEON_ORG_ID=<your_neon_organization_id>
